# ==================================
# JeevanSeva Environment Variables
# ==================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----- Server -----
NODE_ENV=development
PORT=5000

# ----- Database (MySQL) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jeevanseva
DB_USER=root
DB_PASSWORD=

# ----- JWT -----
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# ----- CORS -----
CLIENT_URL=http://localhost:5173

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ----- File Uploads -----
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ----- Map (optional, only if using Google Maps) -----
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Enable the Places API (New) in the same Google Cloud project. Keep this key
# server-only; do not add a VITE_ prefix or expose it in client-side code.

# ----- RapidAPI nearby places (optional alternative to Google Places) -----
# RAPIDAPI_KEY=your_rapidapi_key
# RAPIDAPI_HOST=google-maps-places3.p.rapidapi.com
# RAPIDAPI_NEARBY_URL=https://google-maps-places3.p.rapidapi.com/api/gmaps/nearby

# ----- Notifications (future) -----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
